{
  "installation": {
    "version": "22.5.2"
  },
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "production": [
      "default",
      "!{projectRoot}/test/**/*",
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/**/*.test.dart",
      "!{projectRoot}/docs/**/*"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/Taskfile.yml",
      "{workspaceRoot}/.taskfiles/**/*",
      "{workspaceRoot}/Taskfile.Levels.yml",
      "{workspaceRoot}/Taskfile.Release.yml"
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "production",
        "^production"
      ]
    },
    "test": {
      "cache": true,
      "inputs": [
        "default",
        "^default"
      ]
    },
    "lint": {
      "cache": true,
      "inputs": [
        "default",
        "^default"
      ]
    },
    "validate": {
      "cache": true,
      "dependsOn": [
        "lint",
        "test",
        "build"
      ]
    },
    "deploy": {
      "cache": true,
      "dependsOn": [
        "build"
      ]
    }
  },
  "release": {
    "version": {
      "currentVersionResolver": "disk"
    },
    "groups": {
      "parable-bloom": {
        "projects": [
          "parable-bloom"
        ],
        "version": {
          "currentVersionResolver": "disk"
        },
        "changelog": {
          "automaticFromRef": true
        },
        "releaseTag": {
          "pattern": "v{version}"
        }
      },
      "parable-bloom-site": {
        "projects": [
          "parable-bloom-site"
        ],
        "version": {
          "currentVersionResolver": "disk"
        },
        "changelog": {
          "automaticFromRef": true
        },
        "releaseTag": {
          "pattern": "parable-bloom-site-v{version}"
        }
      },
      "level-builder": {
        "projects": [
          "level-builder"
        ],
        "version": {
          "currentVersionResolver": "disk"
        },
        "changelog": {
          "automaticFromRef": true
        },
        "releaseTag": {
          "pattern": "level-builder-v{version}"
        }
      }
    },
    "changelog": {
      "automaticFromRef": true,
      "projectChangelogs": {
        "renderOptions": {
          "authors": true,
          "mapAuthorsToGithubUsernames": true
        }
      }
    }
  },
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "analytics": true
}
