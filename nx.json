{
  "installation": {
    "version": "23.1.2"
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/test/**/*",
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/**/*.test.dart",
      "!{projectRoot}/docs/**/*"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/Taskfile.yml",
      "{workspaceRoot}/.taskfiles/**/*",
      "{workspaceRoot}/Taskfile.Levels.yml",
      "{workspaceRoot}/Taskfile.Release.yml"
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "test": {
      "cache": true,
      "inputs": ["default", "^default"]
    },
    "lint": {
      "cache": true,
      "inputs": ["default", "^default"]
    },
    "validate": {
      "cache": true,
      "dependsOn": ["lint", "test", "build"]
    },
    "deploy": {
      "cache": true,
      "dependsOn": ["build"]
    }
  },
  "release": {
    "git": {
      "commit": false,
      "tag": false,
      "push": false
    },
    "version": {
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk",
      "specifierSource": "conventional-commits"
    },
    "conventionalCommits": {
      "useCommitScope": false,
      "types": {
        "feat": {
          "semverBump": "minor",
          "changelog": { "hidden": false }
        },
        "fix": {
          "semverBump": "patch",
          "changelog": { "hidden": false }
        },
        "perf": {
          "semverBump": "patch",
          "changelog": { "hidden": false }
        },
        "refactor": {
          "semverBump": "patch",
          "changelog": { "hidden": false }
        },
        "docs": {
          "semverBump": "patch",
          "changelog": { "hidden": false }
        },
        "style": {
          "semverBump": "patch",
          "changelog": { "hidden": false }
        },
        "test": {
          "semverBump": "patch",
          "changelog": { "hidden": false }
        },
        "build": {
          "semverBump": "patch",
          "changelog": { "hidden": false }
        },
        "ci": {
          "semverBump": "patch",
          "changelog": { "hidden": false }
        },
        "chore": {
          "semverBump": "patch",
          "changelog": { "hidden": false }
        },
        "revert": {
          "semverBump": "patch",
          "changelog": { "hidden": false }
        }
      }
    },
    "groups": {
      "parable-bloom": {
        "projects": ["parable-bloom"],
        "changelog": {
          "automaticFromRef": true
        },
        "releaseTag": {
          "pattern": "v{version}"
        }
      },
      "parable-bloom-site": {
        "projects": ["parable-bloom-site"],
        "changelog": {
          "automaticFromRef": true
        },
        "releaseTag": {
          "pattern": "parable-bloom-site-v{version}"
        }
      },
      "level-builder": {
        "projects": ["level-builder"],
        "changelog": {
          "automaticFromRef": true
        },
        "releaseTag": {
          "pattern": "level-builder-v{version}"
        }
      }
    },
    "changelog": {
      "automaticFromRef": true,
      "projectChangelogs": {
        "renderOptions": {
          "authors": true,
          "mapAuthorsToGithubUsernames": true
        }
      }
    }
  },
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "analytics": true,
  "nxCloudId": "6ad2552d530c3895b0e17973"
}
