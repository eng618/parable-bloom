{
  "name": "parable-bloom-site",
  "version": "0.5.22",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev --port 4201",
    "format": "oxfmt --write .",
    "format:ci": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix",
    "prepare": "husky",
    "start": "next start --port 4201",
    "test": "bun test",
    "validate": "node ./scripts/validate.mjs"
  },
  "dependencies": {
    "@gv-tech/design-tokens": "^2.29.1",
    "@gv-tech/ui-core": "^2.29.1",
    "@gv-tech/ui-web": "2.29.1",
    "@openpanel/nextjs": "^1.5.3",
    "@tailwindcss/postcss": "^4.2.1",
    "clsx": "^2.1.1",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@gv-tech/oxc-config": "^1.3.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxfmt --write",
      "oxlint --fix"
    ],
    "*.{json,jsonc,md,yml,yaml}": [
      "oxfmt --write"
    ]
  }
}
