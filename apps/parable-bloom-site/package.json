{
  "name": "parable-bloom-site",
  "version": "0.5.2",
  "scripts": {
    "build": "next build",
    "dev": "next dev --port 4201",
    "format": "prettier --write .",
    "format:ci": "prettier --check .",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --cache --fix",
    "lint:report": "eslint . --cache -o ./eslintReport.html -f html",
    "prepare": "husky",
    "start": "next start --port 4201",
    "test": "bun test",
    "validate": "node ./scripts/validate.mjs"
  },
  "dependencies": {
    "@gv-tech/design-tokens": "^2.28.0",
    "@gv-tech/ui-core": "^2.28.0",
    "@gv-tech/ui-web": "2.28.0",
    "@openpanel/nextjs": "^1.5.1",
    "@tailwindcss/postcss": "^4.2.1",
    "clsx": "^2.1.1",
    "next": "16.2.11",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.7",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@eng618/prettier-config": "^2.10.2",
    "@gv-tech/eslint-config": "^0.1.15",
    "@next/eslint-plugin-next": "^16.3.4",
    "@types/node": "24.7.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "eslint": "^10.10.0",
    "eslint-config-next": "16.2.10",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.2"
  },
  "private": true,
  "lint-staged": {
    "*.(js|ts|mjs|cjs)?(x)": [
      "prettier --write",
      "eslint --cache --fix"
    ],
    "*.(md)?(x)": [
      "prettier --write"
    ]
  },
  "prettier": "@eng618/prettier-config"
}
