{
  "name": "parable-bloom-site",
  "version": "0.5.15",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev --port 4201",
    "format": "oxfmt --write .",
    "format:ci": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix",
    "prepare": "husky",
    "start": "next start --port 4201",
    "test": "bun test",
    "validate": "node ./scripts/validate.mjs"
  },
  "dependencies": {
    "@gv-tech/design-tokens": "^2.28.0",
    "@gv-tech/ui-core": "^2.28.0",
    "@gv-tech/ui-web": "2.28.0",
    "@openpanel/nextjs": "^1.5.1",
    "@tailwindcss/postcss": "^4.2.1",
    "clsx": "^2.1.1",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.3.0",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@gv-tech/oxc-config": "^1.2.0",
    "@types/node": "24.7.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxfmt --write",
      "oxlint --fix"
    ],
    "*.{json,jsonc,md,yml,yaml}": [
      "oxfmt --write"
    ]
  }
